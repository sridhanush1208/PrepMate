# Copy this file to .env and fill in your own values. .env is gitignored, so it never reaches GitHub.

# ---- LLM keys ---------------------------------------------------------------
# You can paste SEVERAL keys per provider, separated by commas (no spaces needed).
# Fallback order: every Gemini key first, then every Groq key.
# A key that hits a rate limit is skipped for 60s; a rejected key is disabled.

# Gemini: free keys from https://aistudio.google.com/
GEMINI_API_KEYS=key_one,key_two
GEMINI_MODEL=gemini-3.8-flash

# Groq (backup): free keys from https://console.groq.com/
GROQ_API_KEYS=
GROQ_MODEL=

# Try "groq,gemini" to use Groq first
LLM_PROVIDER_ORDER=gemini,groq

# ---- FalkorDB -----------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
