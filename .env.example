# Copy this file to .env and fill in your own values. .env is gitignored, so it never reaches GitHub.

# ---- LLM keys and models ----------------------------------------------------
# Paste SEVERAL keys and SEVERAL models per provider, separated by commas.
# Fallback: model 1 on every key, then model 2 on every key, ..., then Groq.
# 429 -> that key rests 60s. 503/timeout -> that model is skipped for the call.
# 401/403 (bad key) and 404 (unknown model) -> disabled.
# See which models your keys can use at:  /api/llm/models

# Gemini: free keys from https://aistudio.google.com/
GEMINI_API_KEYS=key_one,key_two
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite
GEMINI_REASONING_EFFORT=low

# Groq (backup): free keys from https://console.groq.com/
GROQ_API_KEYS=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# Try "groq,gemini" to use Groq first
LLM_PROVIDER_ORDER=gemini,groq
LLM_TIMEOUT_S=20

# ---- FalkorDB -----------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
